#include <iostream>
#include <stack>
using namespace std;

int main(){
    stack <int> s;
    int choice,value;
    do {
        cout << "\n--- MENU ---\n1. Push\n2. Pop\n3. Top\n4. Display\n5. Size\n6. Exit\nChoice: ";
        cin >> choice;
        switch(choice) {
            case 1:
                cout << "Enter Value: ";
                cin >> value;
                s.push(value);
                cout << "Element inserted successfully";
                break;
            case 2:
                if (s.empty())
                    cout << "Stack underflow";
                else {
                    cout << "Deleted element: " << s.top();
                    s.pop();
                }
                break;
            case 3:
                if (s.empty())
                    cout << "Stack is empty";
                else
                    cout << "Top element: " << s.top();
                break;
            case 4:
                if (s.empty())
                    cout << "Stack is empty";
                else {
                    stack <int> temp = s;
                    cout << "Stack elements (top to bottom): ";
                    while(!temp.empty()) {
                        cout << temp.top() << " ";
                        temp.pop();
                    }
                }
                break;
            case 5:
                cout << "Size of stack: " << s.size();
                break;
            case 6:
                cout << "Program terminated";
                break;
            default:
                cout << "Invalid choice";
        }
    } while (choice != 6);
    return 0;
}
