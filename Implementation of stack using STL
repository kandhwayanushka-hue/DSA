#include <iostream>
#include <stack>
using namespace std;

int main(){
    stack <int> s;
    s.push(10);
    s.push(20);
    s.push(30);
    cout<<"Top Elements"<<s.top()<<endl;
    s.pop();
    cout<<"after pop,top elements"<<s.top()<<endl;
    cout<<"size of the stack"<<s.size()<<endl;
    if (s.empty()){
        cout<<"stack is empty"<<endl;
    }else {
        cout<<"Stack is not empty"<<endl;
    }
    cout<<"stack elements:";
    while (!s.empty()){
        cout<<s.top()<<" ";
        s.pop();
    }
    return 0;
}
    
