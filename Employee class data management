<b>when the data is private </b>


#include <iostream>
using namespace std;

class Employee {
private:                              // ← all data hidden
    string name;
    int employee_Id;
    string employee_department;
    float gross_salary;
    float net_salary;

    void calculateNet() {              // private helper — can't be called from main
        if (gross_salary > 5000)
            net_salary = gross_salary - PF;
        else
            net_salary = gross_salary;
    }

public:                               // ← only these accessible from main
    void setSalary(float BA, float DA, float HRA, float PF) {
        gross_salary = BA + DA + HRA;
        calculateNet();                // private method used internally
    }

    float getGrossSalary() { return gross_salary; }  // getter
    float getNetSalary() { return net_salary; }      // getter

    void input_Employee() {
        cout << "Enter name, ID, department: ";
        cin >> name >> employee_Id >> employee_department;
    }

    void display() {
        cout << name << " " << employee_Id << " " << employee_department
             << " | Gross: " << gross_salary << " | Net: " << net_salary << endl;
    }
};

int main() {
    Employee e;
    e.input_Employee();
    e.setSalary(10000, 2000, 1500, 800);
    cout << "Gross: " << e.getGrossSalary() << endl;
    e.display();
    return 0;
}
