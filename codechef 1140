#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while (t--){
	    int n,a,b,c;
	    cin>>n>>a>>b>>c;
	    int type1=min(a,b);
	    b-=type1;
	    int type2=min (b,c);
	    int total=type1+type2;
	    if (total>=n){
	        cout<<"yes"<<endl;
	    }else{
	        cout<<"no"<<endl;
	    }
	    
	}
	return 0;

}
