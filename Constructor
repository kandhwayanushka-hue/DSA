//constructor example 
//default constructor :Student(int x) :id(x) {}

#include <iostream>
using namespace std;

class Student{
	int id;
	public:
		Student():id(0) {}
		void show(){
			cout<<id<<endl;
		}
};
int main(){
	Student s;
	s.show();
	return 0;
}



//copy constructor #include <iostream>
using namespace std;

class Student {
    int id;

public:
    Student() {
        id = 101;
    }

    Student(const Student& s) : id(s.id) {}

    void show() {
        cout << id << endl;
    }
};

int main() {
    Student p;
    p.show();

    Student q = p;
    q.show();

    return 0;
}


